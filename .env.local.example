# Supabase（https://supabase.com でプロジェクト作成後に取得）
SUPABASE_URL=
# Project Settings > API > service_role key。RLS をバイパスするので絶対に公開しない
SUPABASE_SERVICE_ROLE_KEY=

# ログインパスワード（自由に設定）
AUTH_PASSWORD=
# セッション署名用シークレット。変更すると全員ログアウトになる
SESSION_SECRET=

# ------------------------------------------------------------------
# 朝の出荷アラート（/api/cron/shipping-alert）
# ------------------------------------------------------------------
# 必ず Bot 専用アカウントのトークンを使うこと。
# Chatwork は自分自身の投稿を自分に通知しないため、個人のトークンだと
# その本人にだけ通知が届かないという分かりにくい状態になる。
CHATWORK_API_TOKEN=
CHATWORK_ROOM_ID=
# [To:] を付ける account_id をカンマ区切り。空なら付けない
CHATWORK_NOTIFY_TO=

# スケジューラからの呼び出しを認証する共有シークレット。
# 未設定だとエンドポイントは常に 401 を返す（誰でも叩ける状態で公開しないため）。
#   生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# 通知本文に載せる管理画面のURL（任意）。例: https://ec-shitsuji.vercel.app
APP_URL=
